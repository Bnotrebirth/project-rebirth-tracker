{
  "name": "project-rebirth-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project Rebirth live server & player tracker on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "kv:create": "wrangler kv namespace create HISTORY",
    "secret:webhook": "wrangler secret put DISCORD_WEBHOOK_URL",
    "bot": "npm --prefix bot start",
    "bot:register": "npm --prefix bot run register",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
